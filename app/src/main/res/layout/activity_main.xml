<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/camera_preview_description"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toTopOf="@+id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Performance Metrics Overlay -->
    <LinearLayout
        android:id="@+id/performanceOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/performance_overlay_background"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS: --"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/processingTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processing: --ms"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/memoryUsageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memory: --%"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/performanceLevelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level: --"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/frameDropText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drops: --"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Processing Mode Selection -->
    <LinearLayout
        android:id="@+id/processingModeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/performance_overlay_background"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/performanceToggleFab"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode:"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/processingModeSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/processing_mode_description"
            android:importantForAccessibility="yes"
            android:minWidth="120dp" />

    </LinearLayout>

    <!-- Visual Odometry Controls Panel -->
    <LinearLayout
        android:id="@+id/visualOdometryControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="@color/control_panel_background"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnStartCalibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_calibration"
            android:textSize="10sp"
            android:padding="4dp"
            android:layout_margin="2dp"
            android:background="@drawable/button_background" />

        <Button
            android:id="@+id/btnStopCalibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stop_calibration"
            android:textSize="10sp"
            android:padding="4dp"
            android:layout_margin="2dp"
            android:background="@drawable/button_background" />

        <Button
            android:id="@+id/btnPerformCalibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perform_calibration"
            android:textSize="10sp"
            android:padding="4dp"
            android:layout_margin="2dp"
            android:background="@drawable/button_background" />

        <Button
            android:id="@+id/btnSaveCalibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_calibration"
            android:textSize="10sp"
            android:padding="4dp"
            android:layout_margin="2dp"
            android:background="@drawable/button_background" />

        <Button
            android:id="@+id/btnLoadCalibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/load_calibration"
            android:textSize="10sp"
            android:padding="4dp"
            android:layout_margin="2dp"
            android:background="@drawable/button_background" />

        <Button
            android:id="@+id/btnClearCalibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_calibration"
            android:textSize="10sp"
            android:padding="4dp"
            android:layout_margin="2dp"
            android:background="@drawable/button_background" />

    </LinearLayout>

    <!-- Visual Odometry Status and Distance Display -->
    <LinearLayout
        android:id="@+id/visualOdometryStatusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#80000000"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/visualOdometryControlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtCalibrationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calibration: Ready"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtDistanceDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distance: --"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Control Panel with Camera Visualization Toggle and Rotation Button -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/control_panel_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ToggleButton
            android:id="@+id/toggleCameraVisualization"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="Hide Camera"
            android:textOff="Show Camera"
            android:contentDescription="@string/toggle_camera_description"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="16dp"
            android:background="@drawable/toggle_button_background" />

        <Button
            android:id="@+id/btnRotateCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rotate 90°"
            android:contentDescription="@string/rotate_camera_description"
            android:importantForAccessibility="yes"
            android:background="@drawable/button_background"
            android:layout_marginEnd="16dp" />

    </LinearLayout>

    <!-- Performance Toggle Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/performanceToggleFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_performance_24"
        android:contentDescription="@string/performance_toggle_description"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toTopOf="@+id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:fabSize="mini" />

</androidx.constraintlayout.widget.ConstraintLayout>