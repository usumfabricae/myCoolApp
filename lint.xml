<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Disable lint checks that are problematic in CI/CD or for OpenCV -->
    <issue id="MissingPermission" severity="warning">
        <ignore path="**/opencv/**" />
    </issue>
    
    <issue id="InvalidPackage" severity="ignore" />
    
    <!-- Enable important Android 10 compliance checks -->
    <issue id="NewApi" severity="error" />
    <issue id="InlinedApi" severity="warning" />
    <issue id="PrivacyLeakage" severity="warning" />
    
    <!-- Disable checks that are not relevant for this project -->
    <issue id="GoogleAppIndexingWarning" severity="ignore" />
    <issue id="AllowBackup" severity="ignore" />
    
</lint>